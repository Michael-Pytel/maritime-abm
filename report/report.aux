\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Vessel state machine. A vessel cycles \textsc  {Active}\,$\leftrightarrow $\,\textsc  {Docked} along its route; a foundering collision or grounding sends it to \textsc  {Evac} (liferaft), from which the SAR chain yields \textsc  {Rescued} (search detection, Eq.~\ref {eq:cdp}) or \textsc  {Lost} (the survivors are not located before the liferaft survival window elapses). Terminal vessels respawn to maintain fleet size.}}{5}{figure.caption.3}\protected@file@percent }
\newlabel{fig:fsm}{{3}{5}{Vessel state machine. A vessel cycles \textsc {Active}\,$\leftrightarrow $\,\textsc {Docked} along its route; a foundering collision or grounding sends it to \textsc {Evac} (liferaft), from which the SAR chain yields \textsc {Rescued} (search detection, Eq.~\ref {eq:cdp}) or \textsc {Lost} (the survivors are not located before the liferaft survival window elapses). Terminal vessels respawn to maintain fleet size}{figure.caption.3}{}}
